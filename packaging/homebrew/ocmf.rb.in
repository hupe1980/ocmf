# Generated by packaging/homebrew/formula.sh for ocmf @VERSION@; do not edit.
class Ocmf < Formula
  desc "Parse, explain, verify, sign and convert OCMF signed meter records"
  homepage "https://hupe1980.github.io/ocmf/"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/ocmf/releases/download/v@VERSION@/ocmf-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/hupe1980/ocmf/releases/download/v@VERSION@/ocmf-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/ocmf/releases/download/v@VERSION@/ocmf-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/hupe1980/ocmf/releases/download/v@VERSION@/ocmf-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "ocmf"
    # The conformance suite travels with the tool, as in the release archive.
    pkgshare.install "suite.json"
  end

  def caveats
    <<~EOS
      The conformance suite is installed at:
        #{opt_pkgshare}/suite.json
      Run it with:
        ocmf conformance #{opt_pkgshare}/suite.json
    EOS
  end

  test do
    assert_match "ocmf #{version}", shell_output("#{bin}/ocmf --version")
    # OpenSSL is linked statically: all seven [OCMF Tab. 22] algorithms.
    assert_equal 7, shell_output("#{bin}/ocmf curves").lines.count { |l| l.start_with?("  yes") }
    assert_match "0 failed", shell_output("#{bin}/ocmf conformance #{pkgshare}/suite.json")
  end
end
